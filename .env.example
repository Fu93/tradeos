# Copy to .env and fill in. Never commit .env.

# --- PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Offline mode with fake MOCK- IDs (loudly labelled in the UI). Leave 0 for the real Sandbox.
PAYPAL_MOCK=0
# Webhook ID for the signed PAYMENT.CAPTURE.REFUNDED confirmation (scripts/register_webhook.py prints it).
# Empty => webhooks are accepted but recorded as NOT verified.
PAYPAL_WEBHOOK_ID=

# --- LLM for intent extraction (any OpenAI-compatible endpoint; default provider: Groq) ---
# Leave LLM_API_KEY empty to use the deterministic keyword extractor instead.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- App ---
TRADEOS_DB_PATH=tradeos.db
# Wipe + reseed the demo on every start (Render free tier has an ephemeral disk anyway).
TRADEOS_RESET_ON_START=1
# Public URL, used as PayPal return URL in the buyer-approval fallback (Render sets RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=http://localhost:8000
RETURN_WINDOW_DAYS=30

# --- Free-text demo protection (each run creates a real sandbox order + an LLM call) ---
FREE_TEXT_MAX_CHARS=500
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_GLOBAL_PER_HOUR=200
# PayPal sandbox negative-testing code used by the "Refund API failure" demo (one attempt only).
REFUND_FAILURE_MOCK_CODE=REFUND_FAILED_INSUFFICIENT_FUNDS

# --- Autonomy: may the merchant's own policy approve a refund without a person? ---
# OFF by default. When on, a policy-ELIGIBLE refund at or below the limit is approved by the
# merchant's policy and recorded on the audit chain as approval_source=auto — never as a human.
# Everything else still goes to a person: policy rejections, instruction-like messages, requests
# the AI could not read, and any amount above the limit.
AUTO_ENABLED=0
AUTO_REFUND_MAX_AMOUNT=50.00
# May the merchant's own policy approve a size exchange too? Needs AUTO_ENABLED as well.
# No money moves on the exchange path, whoever approves it.
AUTO_EXCHANGE_ENABLED=0

# --- Illustrative cost model assumptions (plan §6) ---
COST_HUMAN_MINUTES=8
COST_HOURLY_RATE_USD=20
COST_AI_API_USD=0.06
COST_REVIEW_MINUTES=1
