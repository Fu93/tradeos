# Copy to .env and fill in. Never commit .env.

# --- PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Offline mode with fake MOCK- IDs (loudly labelled in the UI). Leave 0 for the real Sandbox.
PAYPAL_MOCK=0

# --- LLM for intent extraction (any OpenAI-compatible endpoint; default provider: Groq) ---
# Leave LLM_API_KEY empty to use the deterministic keyword extractor instead.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- App ---
TRADEOS_DB_PATH=tradeos.db
# Wipe + reseed the demo on every start (Render free tier has an ephemeral disk anyway).
TRADEOS_RESET_ON_START=1
# Public URL, used as PayPal return URL in the buyer-approval fallback (Render sets RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=http://localhost:8000
RETURN_WINDOW_DAYS=30

# --- Illustrative cost model assumptions (plan §6) ---
COST_HUMAN_MINUTES=8
COST_HOURLY_RATE_USD=20
COST_AI_API_USD=0.06
COST_REVIEW_MINUTES=1
